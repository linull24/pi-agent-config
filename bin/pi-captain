#!/bin/sh
# captain (C) — the persistent QQ gateway that converses with the active pi session (A).
# QQ credentials are read from the hermes .env at runtime (never copied elsewhere). Defaults to agnes.
# Target session: $PI_CAPTAIN_SESSION, else the newest durable session that already has a user turn.
set -eu

ENV_FILE="${CAPTAIN_ENV_FILE:-$HOME/.hermes/.env}"
if [ -f "$ENV_FILE" ]; then
  set -a
  # shellcheck disable=SC1090
  . "$ENV_FILE"
  set +a
fi

export PI_NO_DESKTOP_NOTIFY=1
export PI_CAPTAIN_MODEL="${PI_CAPTAIN_MODEL:-agnes/agnes-2.5-flash}"
exec "$HOME/pi-src/pi-test.sh" captain ${PI_CAPTAIN_SESSION:+$PI_CAPTAIN_SESSION}
